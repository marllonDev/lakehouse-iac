ame                           as source_file,\n    current_timestamp()                           as ingested_at\n\nfrom stream read_files(\n    '/Volumes/dev_lakehouse/raw/landing/wikipedia',\n    format => 'json',\n    schemaEvolutionMode => 'addNewColumns'\n)\nTable Properties: [pipelines.pipelineId=f21f1b47-ed80-4982-bf49-68e9b1c7b679]\nSchema: root\n |-- event_uuid: string (nullable = true)\n |-- recent_change_id: long (nullable = true)\n |-- event_at: string (nullable = true)\n |-- edited_at: timestamp (nullable = true)\n |-- wiki_code: string (nullable = true)\n |-- wiki_domain: string (nullable = true)\n |-- change_type: string (nullable = true)\n |-- namespace_id: integer (nullable = true)\n |-- page_title: string (nullable = true)\n |-- editor_name: string (nullable = true)\n |-- is_bot: boolean (nullable = true)\n |-- is_minor: boolean (nullable = true)\n |-- length_before: integer (nullable = true)\n |-- length_after: integer (nullable = true)\n |-- bytes_changed: integer (nullable = true)\n |-- edit_comment: string (nullable = true)\n |-- source_file: string (nullable = true)\n |-- ingested_at: timestamp (nullable = true)\n", "owner": null}, "columns": {"event_uuid": {"type": "string", "index": 0, "name": "event_uuid", "comment": null}, "recent_change_id": {"type": "bigint", "index": 1, "name": "recent_change_id", "comment": null}, "event_at": {"type": "string", "index": 2, "name": "event_at", "comment": null}, "edited_at": {"type": "timestamp", "index": 3, "name": "edited_at", "comment": null}, "wiki_code": {"type": "string", "index": 4, "name": "wiki_code", "comment": null}, "wiki_domain": {"type": "string", "index": 5, "name": "wiki_domain", "comment": null}, "change_type": {"type": "string", "index": 6, "name": "change_type", "comment": null}, "namespace_id": {"type": "integer", "index": 7, "name": "namespace_id", "comment": null}, "page_title": {"type": "string", "index": 8, "name": "page_title", "comment": null}, "editor_name": {"type": "string", "